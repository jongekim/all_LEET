{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(login|signup|forgot-password|reset-password|history|mock-history|admission|admission-result|mock-input|result|chat|community|privacy-policy|terms|admin)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(community|admin)/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/icon.svg", "destination": "/icon.svg" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/past-exams", "destination": "/past-exams.html" },
    { "source": "/question-rates", "destination": "/question-rates.html" },
    { "source": "^/past-exams/(?<year>\\d{4})$", "destination": "/past-exams/$year.html" },
    { "source": "/(login|signup|forgot-password|reset-password|history|mock-history|admission|admission-result|mock-input|result|chat|community|privacy-policy|terms|admin)", "destination": "/app.html" },
    { "source": "/(community|admin)/(.*)", "destination": "/app.html" }
  ]
}
